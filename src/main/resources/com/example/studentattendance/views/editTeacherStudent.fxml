<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="editPane" prefHeight="580.0" prefWidth="850.0"
            style="-fx-background-color: #f8fafc;"
            stylesheets="@../styles/style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentattendance.controller.EditTeacherStudentController">
    <children>
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER_LEFT" maxWidth="480.0" spacing="0.0" styleClass="card-elevated">
                    <children>
                        <HBox alignment="CENTER">
                            <children>
                                <Label styleClass="badge" text="%editteacherstudent.badge" />
                            </children>
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </HBox>

                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="heading-1" text="%editteacherstudent.title" textAlignment="CENTER" />
                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="text-muted" text="%editteacherstudent.subtitle" textAlignment="CENTER">
                            <VBox.margin>
                                <Insets bottom="24.0" top="4.0" />
                            </VBox.margin>
                        </Label>

                        <VBox spacing="14.0">
                            <children>
                                <VBox spacing="6.0">
                                    <children>
                                        <Label style="-fx-font-weight: 600; -fx-text-fill: #334155;" text="%editteacherstudent.id" />
                                        <TextField fx:id="id" prefHeight="40.0" promptText="%editteacherstudent.prompt.id" />
                                    </children>
                                </VBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label style="-fx-font-weight: 600; -fx-text-fill: #334155;" text="%editteacherstudent.lecture" />
                                        <HBox spacing="10.0">
                                            <children>
                                                <TextField fx:id="lecture" prefHeight="40.0" promptText="%editteacherstudent.prompt.lecture" HBox.hgrow="ALWAYS" />
                                                <Button onAction="#check" prefHeight="40.0" prefWidth="90.0" styleClass="btn-secondary" text="%editteacherstudent.btn.find" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label style="-fx-font-weight: 600; -fx-text-fill: #334155;" text="%editteacherstudent.attendance" />
                                        <TextField fx:id="attendance" prefHeight="40.0" promptText="%editteacherstudent.prompt.attendance" />
                                    </children>
                                </VBox>

                                <VBox spacing="10.0">
                                    <children>
                                        <Button fx:id="saveButton" maxWidth="1.7976931348623157E308" onAction="#save" prefHeight="42.0" styleClass="button" text="%editteacherstudent.btn.save" />
                                        <Button maxWidth="1.7976931348623157E308" onAction="#back" prefHeight="38.0" styleClass="btn-secondary" text="%editteacherstudent.btn.back" />
                                    </children>
                                    <VBox.margin>
                                        <Insets top="10.0" />
                                    </VBox.margin>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>
