<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="addPane" alignment="CENTER" prefHeight="580.0" prefWidth="850.0"
      style="-fx-background-color: #f8fafc;"
      stylesheets="@../styles/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.studentattendance.controller.AddAccountController">
    <children>
        <VBox alignment="CENTER_LEFT" maxWidth="460.0" spacing="0.0" styleClass="card-elevated">
            <children>
                <HBox alignment="CENTER">
                    <children>
                        <Label styleClass="badge" text="%addaccount.badge" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </HBox>

                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="heading-1" text="%addaccount.title" textAlignment="CENTER" />
                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="text-muted" text="%addaccount.subtitle" textAlignment="CENTER" wrapText="true">
                    <VBox.margin>
                        <Insets bottom="20.0" top="4.0" />
                    </VBox.margin>
                </Label>

                <VBox spacing="14.0">
                    <children>
                        <VBox spacing="6.0">
                            <children>
                                <Label style="-fx-font-weight: 600; -fx-text-fill: #334155;" text="%addaccount.username" />
                                <TextField fx:id="username" prefHeight="40.0" promptText="%addaccount.prompt.username" />
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label style="-fx-font-weight: 600; -fx-text-fill: #334155;" text="%addaccount.password" />
                                <PasswordField fx:id="password" prefHeight="40.0" promptText="%addaccount.prompt.password" />
                            </children>
                        </VBox>

                        <!-- Role Selection (Admin, Doctor/Teacher, Student) -->
                        <VBox spacing="6.0">
                            <children>
                                <Label style="-fx-font-weight: 600; -fx-text-fill: #334155;" text="%addaccount.role" />
                                <ChoiceBox fx:id="roleChoiceBox" maxWidth="1.7976931348623157E308" prefHeight="40.0" />
                            </children>
                            <VBox.margin>
                                <Insets bottom="6.0" top="2.0" />
                            </VBox.margin>
                        </VBox>

                        <VBox spacing="10.0">
                            <children>
                                <Button maxWidth="1.7976931348623157E308" onAction="#onAdd" prefHeight="42.0" styleClass="button" text="%addaccount.btn.create" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#onBack" prefHeight="38.0" styleClass="btn-secondary" text="%addaccount.btn.back" />
                            </children>
                            <VBox.margin>
                                <Insets top="8.0" />
                            </VBox.margin>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>
