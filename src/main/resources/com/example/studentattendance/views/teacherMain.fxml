<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="teacherMain" prefHeight="600.0" prefWidth="900.0"
            stylesheets="@../styles/style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentattendance.controller.TeacherMainController">
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <!-- Sleek Left Sidebar -->
            <left>
                <VBox prefWidth="230.0" styleClass="sidebar" BorderPane.alignment="CENTER">
                    <children>
                        <!-- Brand -->
                        <VBox spacing="2.0">
                            <children>
                                <Label styleClass="sidebar-brand-title" text="%teacher.brand.title" />
                                <Label styleClass="sidebar-brand-subtitle" text="%teacher.brand.subtitle" />
                            </children>
                            <VBox.margin>
                                <Insets bottom="16.0" left="4.0" right="4.0" top="6.0" />
                            </VBox.margin>
                        </VBox>

                        <!-- User Profile Card in Sidebar -->
                        <VBox spacing="4.0" styleClass="sidebar-user-pill">
                            <children>
                                <Label styleClass="sidebar-user-role" text="%teacher.user.role" />
                                <Label fx:id="username" styleClass="sidebar-user-name" text="Teacher Name" />
                            </children>
                            <VBox.margin>
                                <Insets bottom="20.0" />
                            </VBox.margin>
                        </VBox>

                        <!-- Nav Section Label -->
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"
                               text="%teacher.nav.label">
                            <VBox.margin>
                                <Insets bottom="6.0" left="8.0" />
                            </VBox.margin>
                        </Label>

                        <!-- Nav Buttons -->
                        <VBox spacing="8.0">
                            <children>
                                <Button maxWidth="1.7976931348623157E308" onAction="#onStudent"
                                        styleClass="sidebar-nav-btn" text="%teacher.nav.students" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#onAttendance"
                                        styleClass="sidebar-nav-btn" text="%teacher.nav.attendance" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#report"
                                        styleClass="sidebar-nav-btn" text="%teacher.nav.report" />
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Logout -->
                        <Button maxWidth="1.7976931348623157E308" onAction="#onLogOut"
                                styleClass="sidebar-nav-btn-danger" text="%teacher.nav.logout" />
                    </children>
                </VBox>
            </left>

            <!-- Main Content Area -->
            <center>
                <VBox spacing="24.0" style="-fx-background-color: #f8fafc;" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
                    </padding>
                    <children>
                        <!-- Header -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="heading-hero" text="%teacher.header.title" />
                                        <Label styleClass="badge" text="%teacher.header.badge" />
                                    </children>
                                </HBox>
                                <Label styleClass="text-muted" text="%teacher.header.subtitle" />
                            </children>
                        </VBox>

                        <!-- Feature Cards -->
                        <GridPane hgap="20.0" vgap="20.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="130.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <VBox spacing="10.0" styleClass="stat-card">
                                    <children>
                                        <Label styleClass="badge" text="%teacher.card1.badge" />
                                        <Label styleClass="heading-2" text="%teacher.card1.title" />
                                        <Label styleClass="text-muted" text="%teacher.card1.text" wrapText="true" />
                                    </children>
                                </VBox>
                                <VBox spacing="10.0" styleClass="stat-card" GridPane.columnIndex="1">
                                    <children>
                                        <Label styleClass="badge" text="%teacher.card2.badge" />
                                        <Label styleClass="heading-2" text="%teacher.card2.title" />
                                        <Label styleClass="text-muted" text="%teacher.card2.text" wrapText="true" />
                                    </children>
                                </VBox>
                                <VBox spacing="10.0" styleClass="stat-card" GridPane.columnIndex="2">
                                    <children>
                                        <Label styleClass="badge" text="%teacher.card3.badge" />
                                        <Label styleClass="heading-2" text="%teacher.card3.title" />
                                        <Label styleClass="text-muted" text="%teacher.card3.text" wrapText="true" />
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>

                        <!-- Workflow Card -->
                        <VBox spacing="12.0" styleClass="card" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="heading-2" text="%teacher.workflow.title" />
                                <Label styleClass="text-muted" text="%teacher.workflow.text" wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label style="-fx-text-fill: #10b981; -fx-font-weight: bold;"
                                               text="%teacher.status" />
                                        <Label styleClass="text-muted" text="%teacher.storage" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 10.5px; -fx-font-style: italic;"
                                               text="%app.copyright" mouseTransparent="true" pickOnBounds="false" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
