<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="lecturePane" prefHeight="600.0" prefWidth="900.0"
            stylesheets="@../styles/style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentattendance.controller.LectureController">
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <!-- Header Toolbar -->
            <top>
                <VBox spacing="14.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1px 0;" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="16.0" left="28.0" right="28.0" top="18.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Button onAction="#back" styleClass="btn-secondary" text="%lecture.btn.back" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#add" styleClass="button" text="%lecture.btn.add" />
                                <Button onAction="#edit" styleClass="btn-secondary" text="%lecture.btn.edit" />
                                <Button onAction="#delete" styleClass="btn-outline-danger" text="%lecture.btn.delete" />
                            </children>
                        </HBox>
                        <VBox spacing="2.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="heading-1" text="%lecture.header.title" />
                                        <Label styleClass="badge" text="%lecture.header.badge" />
                                    </children>
                                </HBox>
                                <Label styleClass="text-muted" text="%lecture.header.subtitle" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </top>

            <!-- Table Container -->
            <center>
                <VBox spacing="16.0" style="-fx-background-color: #f8fafc;" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="24.0" left="28.0" right="28.0" top="20.0" />
                    </padding>
                    <children>
                        <TableView fx:id="table" styleClass="table-view" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="codeColumn" prefWidth="120.0" text="%lecture.col.code" />
                                <TableColumn fx:id="teacherCode" prefWidth="120.0" text="%lecture.col.teacher_code" />
                                <TableColumn fx:id="TeacherName" prefWidth="220.0" text="%lecture.col.teacher_name" />
                                <TableColumn fx:id="Lecture" prefWidth="240.0" text="%lecture.col.name" />
                                <TableColumn fx:id="Classroom" prefWidth="150.0" text="%lecture.col.classroom" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 10.5px; -fx-font-style: italic;"
                                       text="%app.copyright" mouseTransparent="true" pickOnBounds="false" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
